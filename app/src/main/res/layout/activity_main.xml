<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/new_background"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="700dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/morningBtn"
            android:layout_width="95dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="@drawable/morning_shape"
            android:fontFamily="@font/yeon_sung"
            android:onClick="btnMorningClick"
            android:text="@string/morning"
            android:textSize="16sp"
            android:textColor="@color/darkBlue"
            app:backgroundTint="@null">
        </Button>

        <Button
            android:id="@+id/dayBtn"
            android:layout_width="95dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:onClick="btnDayClick"
            android:text="@string/day"
            android:textSize="16sp"
            android:background="@drawable/day_shape"
            android:textColor="@color/darkBlue"
            app:backgroundTint="@null">
        </Button>


        <Button
            android:id="@+id/eveningBtn"
            android:layout_width="95dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:onClick="btnEveningClick"
            android:text="@string/evening"
            android:textSize="16sp"
            android:background="@drawable/evening_shape"
            app:backgroundTint="@null">
        </Button>

        <Button
            android:id="@+id/nightBtn"
            android:layout_width="95dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:onClick="btnNightClick"
            android:text="@string/night"
            android:textSize="16sp"
            android:background="@drawable/night_shape"
            app:backgroundTint="@null">
        </Button>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="700dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="150dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <ImageView
            android:id="@+id/imgNight"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            android:src="@drawable/night">
        </ImageView>

        <ImageView
            android:id="@+id/imgEvening"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            android:src="@drawable/evening">
        </ImageView>

        <ImageView
            android:id="@+id/imgDay"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            android:src="@drawable/day">
        </ImageView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMorning"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <ImageView
                android:id="@+id/imgMorning"
                android:layout_width="400dp"
                android:layout_height="wrap_content"
                android:visibility="visible"
                android:src="@drawable/morning"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toRightOf="parent">
            </ImageView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>




</androidx.constraintlayout.widget.ConstraintLayout>